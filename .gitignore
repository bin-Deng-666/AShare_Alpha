# Local datasets, experiments, reports and historical archives
workspace/
.local_research/

# Publish only the example strategy and its index
strategy/*
!strategy/__init__.py
!strategy/README.md
!strategy/demo/
src/web/strategies/*
!src/web/strategies/__init__.py
!src/web/strategies/demo/

# Python environments and build tools
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Frontend development dependencies and reports
node_modules/
tests/browser/playwright-report/
tests/browser/test-results/

# OS/editor files and local assistant context
.DS_Store
.idea/
.vscode/
.trae/
.uploads/

# Credentials and machine-local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Generated data/model files are never source
*.parquet
*.duckdb
*.duckdb.wal
*.lgb
*.cbm
*.pt
*.pth
*.onnx
*.npy
*.npz
*.pkl
*.pickle
*.joblib
**/catboost_info/

# Logs, temporary files and unadopted drafts
*.log
*.tmp
*.bak
**/*_draft.md
